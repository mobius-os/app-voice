{
  "id": "voice",
  "name": "Voice",
  "version": "1.12.9",
  "description": "Give your agent a voice in chat or any compatible app.",
  "author": "mobius-os",
  "license": "MIT",
  "entry": "index.jsx",
  "icon": "icon.png",
  "skills": [
    "voice.md"
  ],
  "source_files": [
    "THIRD_PARTY_NOTICES.md",
    "clones.js",
    "icon-data.js",
    "local-speech.js",
    "licenses/XN-RUNTIME-LICENSES.md",
    "voice.md"
  ],
  "static_assets": {
    "voice-samples/pocket-tts-alba.wav": "static/voice-samples/pocket-tts-alba.wav",
    "voice-samples/pocket-tts-azelma.wav": "static/voice-samples/pocket-tts-azelma.wav",
    "voice-samples/pocket-tts-cosette.wav": "static/voice-samples/pocket-tts-cosette.wav",
    "voice-samples/pocket-tts-eponine.wav": "static/voice-samples/pocket-tts-eponine.wav",
    "voice-samples/pocket-tts-fantine.wav": "static/voice-samples/pocket-tts-fantine.wav",
    "voice-samples/pocket-tts-giovanni.wav": "static/voice-samples/pocket-tts-giovanni.wav",
    "voice-samples/pocket-tts-javert.wav": "static/voice-samples/pocket-tts-javert.wav",
    "voice-samples/pocket-tts-jean.wav": "static/voice-samples/pocket-tts-jean.wav",
    "voice-samples/pocket-tts-juergen.wav": "static/voice-samples/pocket-tts-juergen.wav",
    "voice-samples/pocket-tts-lola.wav": "static/voice-samples/pocket-tts-lola.wav",
    "voice-samples/pocket-tts-marius.wav": "static/voice-samples/pocket-tts-marius.wav",
    "voice-samples/pocket-tts-rafael.wav": "static/voice-samples/pocket-tts-rafael.wav"
  },
  "offline_capable": false,
  "capabilities": {
    "device.speech-models": {
      "version": 1,
      "reason": "Download, verify, select, and remove local voices, including a per-device mirror of a private clone stored on this M\u00f6bius instance.",
      "limits": {
        "max_bytes": 805306368,
        "max_asset_bytes": 268435456,
        "max_chunk_bytes": 8388608
      }
    },
    "media.speech": {
      "version": 1,
      "reason": "Preview the selected voice without sending text or audio off this device.",
      "limits": {
        "max_text_chars": 5000
      }
    },
    "media.microphone.capture": {
      "version": 1,
      "reason": "Record a short private sample when you choose to clone your voice.",
      "limits": {
        "max_duration_ms": 8000
      }
    }
  },
  "permissions": {
    "cross_app_access": "none",
    "share_with_apps": "none"
  },
  "runtime": {
    "imports": [
      "react",
      "react-dom",
      "@openai/apps-sdk-ui/components/Icon"
    ],
    "esm_deps": []
  },
  "homepage": "https://github.com/mobius-os/app-voice"
}
